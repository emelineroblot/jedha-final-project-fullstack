# ========================================
# Configuration Projet Impact Environnemental
# ========================================

# Copier ce fichier en .env et remplir les valeurs

# ========================================
# API KEYS (si nécessaire)
# ========================================

# World Bank API (généralement pas besoin de clé)
# WORLD_BANK_API_KEY=

# FAO API (généralement pas besoin de clé)
# FAO_API_KEY=

# UN Comtrade (inscription gratuite: https://comtradeplus.un.org/)
# COMTRADE_API_KEY=your_key_here

# USDA Food Data Central (optionnel)
# USDA_API_KEY=your_key_here

# ========================================
# DATABASE CONFIGURATION
# ========================================

# PostgreSQL (si utilisé)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=impact_envt_db
# DB_USER=your_username
# DB_PASSWORD=your_password

# DuckDB (recommandé pour démarrer, pas besoin de config)
DB_TYPE=duckdb
DB_PATH=data/impact_envt.duckdb

# ========================================
# MLFLOW
# ========================================
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=impact_environnemental

# ========================================
# STREAMLIT (pour déploiement)
# ========================================
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost

# ========================================
# PATHS
# ========================================
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed
MODELS_PATH=models
NOTEBOOKS_PATH=notebooks

# ========================================
# ETL CONFIGURATION
# ========================================
# Années à analyser
START_YEAR=1961
END_YEAR=2023

# Seuil pour détecter les outliers (nombre d'écarts-types)
OUTLIER_THRESHOLD=3

# Stratégie pour les valeurs manquantes: drop, mean, median, mode
NULL_STRATEGY=median
