#!/bin/bash
# .githooks/post-checkout — installer avec : git config core.hooksPath .githooks
echo "Welcome to the Final Project Repository!"
# Check if .env exists
if [ ! -f "./.env" ]; then
    if [ -f "./.github/.env.template" ]; then
        echo "Creating .env from .env.template..."
        cp ./.github/.env.template ./.env
        echo "✅ .env file created."
        echo "⚠️  Remember to edit .env with your personal credentials!"
    else
        echo "❌ .env.template not found. Please ask your team."
    fi
else
    echo "✅ .env already present."
fi