# ============================================================
# PostgreSQL — développement local (Docker)
# Copier ce fichier en ../.env et adapter les valeurs
# ============================================================

# Local (Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=food_impact
POSTGRES_USER=food_user
POSTGRES_PASSWORD=food_pass

# ============================================================
# PostgreSQL — production AWS
# Décommenter et remplir lors du déploiement
# ============================================================
# POSTGRES_HOST=your-instance.rdb.nl-ams.aws.com
# POSTGRES_PORT=12345
# POSTGRES_DB=food_impact
# POSTGRES_USER=food_user
# POSTGRES_PASSWORD=your-secure-password
