# ============================================================
# Template de configuration — copier vers ../.env et compléter
#   cp docker/.env.example .env
# Le fichier .env n'est JAMAIS versionné.
# ============================================================

# ── PostgreSQL local (Docker) ───────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=food_impact
POSTGRES_USER=food_user
POSTGRES_PASSWORD=food_pass
POSTGRES_SSLMODE=prefer

# ── PostgreSQL production — AWS RDS ─────────────────────────
# Décommenter ce bloc et commenter le précédent pour basculer.
# Aucun code n'est à modifier : la connexion est entièrement
# dérivée de ces variables.
#
# POSTGRES_HOST=<instance>.<id>.<region>.rds.amazonaws.com
# POSTGRES_PORT=5432
# POSTGRES_DB=food_impact
# POSTGRES_USER=food_app          # compte applicatif en LECTURE SEULE
# POSTGRES_PASSWORD=<mot-de-passe-food_app>
# POSTGRES_SSLMODE=require        # obligatoire sur RDS

# ── Compte maître RDS — ETL et migrations uniquement ────────
# Ne jamais l'utiliser pour l'application.
#
# RDS_HOST=<instance>.<id>.<region>.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DB=food_impact
# RDS_USER=food_admin
# RDS_PASSWORD=<mot-de-passe-maitre>
# RDS_SSLMODE=require
